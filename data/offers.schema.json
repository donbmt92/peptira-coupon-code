{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/peptira-offers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "merchant", "retrieved_at", "offers"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "merchant": { "const": "Peptira" },
    "retrieved_at": { "type": "string", "format": "date-time" },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/offer" }
    }
  },
  "$defs": {
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "offer_type", "status", "code", "discount",
        "conditions", "observation", "verification", "sources", "conflicts"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "offer_type": {
          "enum": ["code", "sale", "shipping", "informational", "composite"]
        },
        "status": { "enum": ["active", "expired", "unclear"] },
        "code": { "type": ["string", "null"], "minLength": 1 },
        "discount": { "$ref": "#/$defs/discount" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "observation": { "$ref": "#/$defs/observation" },
        "verification": { "$ref": "#/$defs/verification" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source" }
        },
        "conflicts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "discount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "currency", "components", "calculation_note"],
      "properties": {
        "kind": {
          "enum": ["percent", "fixed", "bogo", "shipping", "composite", "informational"]
        },
        "value": { "type": ["number", "null"], "minimum": 0 },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "value", "description"],
            "properties": {
              "kind": { "enum": ["percent", "fixed", "bogo", "shipping", "sale"] },
              "value": { "type": ["number", "null"], "minimum": 0 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        },
        "calculation_note": { "type": "string", "minLength": 1 }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_subtotal", "eligible_scope", "payment_methods", "regions", "stacking", "notes"],
      "properties": {
        "min_subtotal": { "type": ["number", "null"], "minimum": 0 },
        "eligible_scope": { "type": "string", "minLength": 1 },
        "payment_methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "stacking": { "enum": ["allowed", "not_allowed", "publisher_reported", "unknown", "not_applicable"] },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_seen_at", "last_seen_at", "expires_at", "expiration_text", "stale_after_days"],
      "properties": {
        "first_seen_at": { "type": "string", "format": "date-time" },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "expiration_text": { "type": ["string", "null"] },
        "stale_after_days": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "publisher_claim", "publisher_verified_at", "independently_checkout_verified"],
      "properties": {
        "level": { "enum": ["publisher_reported", "source_observed", "independently_checkout_verified"] },
        "publisher_claim": { "type": ["string", "null"] },
        "publisher_verified_at": { "type": ["string", "null"], "format": "date-time" },
        "independently_checkout_verified": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "retrieved_at", "evidence"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}

